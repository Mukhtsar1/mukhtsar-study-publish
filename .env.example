# Copy to .env and fill in. Never commit .env.

# Pexels — free API key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Instagram Graph API
# IG_USER_ID is the Instagram *professional account* id (not the handle)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Where the rendered PNGs are publicly served from.
# Instagram fetches images by URL; it cannot accept uploads.
# GitHub example:
IMAGE_BASE_URL=https://raw.githubusercontent.com/YOURUSER/mukhtsar-study/main/out
